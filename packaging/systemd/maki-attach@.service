# Privileged one-shot helper (SPEC §4, §6): NBD attach, LVM activation,
# XFS mount and identity verification. Runs as root, but by construction
# has zero access to crypto secrets (PRIV-010): no credential directives in
# this unit, and the maki-attach binary contains no crypto code.
#
# Attach parameters (volume UUID, mountpoint, VG/LV, optional fixed NBD
# device, optional expected XFS UUID) come from the root-owned
# /etc/maki/attach/%i.toml (see packaging/examples/attach.toml). The unit
# becomes active after the mount identity check passes. RemainAfterExit
# retains that historical success; it does not continuously verify the mount.
# Services need Requires= and After= plus a fresh identity check before each
# workload start, including restarts outside systemd's dependency start job.

[Unit]
Description=Maki attach helper for volume %i
Requires=maki@%i.service
After=maki@%i.service
# A missing required config must fail the start job: a Condition would
# merely skip attach and permit ordered Requires= workloads to start.
AssertPathExists=/etc/maki/attach/%i.toml

[Service]
Type=oneshot
RemainAfterExit=yes

# systemd disables the *start* timeout by default for Type=oneshot, so a hung
# helper — a stuck nbd-client, mount, or umount — would hold the global attach
# lock indefinitely and block every other volume's attach/detach/grow. Bound
# both jobs so systemd terminates a stuck helper and releases the lock. The
# values sit above the internal 15s NBD readiness wait plus expected XFS mount
# log recovery; timeout recovery still re-observes actual kernel state on the
# next attempt (R05).
TimeoutStartSec=180
TimeoutStopSec=120

ExecStart=/usr/bin/maki-attach attach --volume %i
ExecStop=/usr/bin/maki-attach detach --volume %i

[Install]
WantedBy=multi-user.target
