# Maki data-plane daemon: one instance per volume (SPEC §3, §10).
# The daemon runs as the unprivileged `maki` user with an empty capability
# set; every privileged operation goes through maki-attach@.service.

[Unit]
Description=Maki encrypted volume %i
After=network-online.target
Wants=network-online.target
PartOf=maki-workload@%i.target
OnFailure=maki-recover@%i.service
OnFailureJobMode=replace-irreversibly
# Bound automatic recovery loops when daemon startup cannot succeed.
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
# The native plugin initializes after fork and sends READY only after recovery,
# provider verification and control binding. Ordered attach jobs wait for it.
Type=notify
NotifyAccess=main
TimeoutStartSec=180

User=maki
Group=maki

ExecStart=/usr/bin/nbdkit \
    --foreground \
    -U /run/maki/%i/nbd.sock \
    /usr/lib/maki/maki-nbdkit.so \
    config=/etc/maki/volumes/%i.toml

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=

# PRIV-015: never write core dumps (plaintext/key material may be mapped).
LimitCORE=0
LimitMEMLOCK=512M

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# R5-002: the daemon never opens a device node (a crafted one inside a volume
# included); only the pseudo devices remain. PrivateDevices= would also hide
# the /dev nodes the swap policy check stats, so the cgroup policy is used.
DevicePolicy=closed
# R5-031: nothing here needs kernel logs, the clock, the hostname, realtime
# scheduling, new namespaces or a foreign syscall ABI; sockets are UNIX
# (NBD, control, sd_notify), IP (remote providers) and netlink (glibc
# getaddrinfo with AI_ADDRCONFIG).
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Systemd's service baseline. Three packaged PostgreSQL lifecycles with the
# local provider ran under it without a denial (2026-10-03); EPERM makes a
# missed syscall an error rather than a SIGSYS kill.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
LockPersonality=yes

# Top-level tmpfiles directories select who can enter each socket tree.
# Children permit traversal; NBD remains behind root:maki /run/maki,
# while administrators enter root:maki-admin /run/maki-control.
RuntimeDirectory=maki/%i maki-control/%i
RuntimeDirectoryMode=0711
ReadWritePaths=/var/lib/maki/%i
ReadWritePaths=/run/maki/%i
ReadWritePaths=/run/maki-control/%i

# SPEC §9: secrets arrive as systemd credentials, never in the TOML.
# This directive is enabled: provision the per-volume token file before start.
# Override its source path in a service drop-in if secrets are stored elsewhere.
LoadCredential=crypto-token:/etc/maki/secrets/%i.token
