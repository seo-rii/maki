# Maki data-plane daemon: one instance per volume (SPEC §3, §10).
# The daemon runs as the unprivileged `maki` user with an empty capability
# set; every privileged operation goes through maki-attach@.service.

[Unit]
Description=Maki encrypted volume %i
After=network-online.target
Wants=network-online.target
PartOf=maki-workload@%i.target
OnFailure=maki-recover@%i.service
OnFailureJobMode=replace-irreversibly
# Bound automatic recovery loops when daemon startup cannot succeed.
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
# The native plugin initializes after fork and sends READY only after recovery,
# provider verification and control binding. Ordered attach jobs wait for it.
Type=notify
NotifyAccess=main
TimeoutStartSec=180

User=maki
Group=maki

ExecStart=/usr/bin/nbdkit \
    --foreground \
    -U /run/maki/%i/nbd.sock \
    /usr/lib/maki/maki-nbdkit.so \
    config=/etc/maki/volumes/%i.toml

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=

# PRIV-015: never write core dumps (plaintext/key material may be mapped).
LimitCORE=0
LimitMEMLOCK=512M

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# Top-level tmpfiles directories select who can enter each socket tree.
# Children permit traversal; NBD remains behind root:maki /run/maki,
# while administrators enter root:maki-admin /run/maki-control.
RuntimeDirectory=maki/%i maki-control/%i
RuntimeDirectoryMode=0711
ReadWritePaths=/var/lib/maki/%i
ReadWritePaths=/run/maki/%i
ReadWritePaths=/run/maki-control/%i

# SPEC §9: secrets arrive as systemd credentials, never in the TOML.
# This directive is enabled: provision the per-volume token file before start.
# Override its source path in a service drop-in if secrets are stored elsewhere.
LoadCredential=crypto-token:/etc/maki/secrets/%i.token
