# Maki data-plane daemon: one instance per volume (SPEC §3, §10).
# The daemon runs as the unprivileged `maki` user with an empty capability
# set; every privileged operation goes through maki-attach@.service.

[Unit]
Description=Maki encrypted volume %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

User=maki
Group=maki

ExecStart=/usr/bin/nbdkit \
    --foreground \
    -U /run/maki/%i/nbd.sock \
    /usr/lib/maki/maki-nbdkit.so \
    config=/etc/maki/volumes/%i.toml

Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=

# PRIV-015: never write core dumps (plaintext/key material may be mapped).
LimitCORE=0
LimitMEMLOCK=512M

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# Everything the daemon creates is private to it: backing files (the
# backing layer forces 0600/0700 anyway) and, above all, the NBD socket
# nbdkit creates under this umask, so only the maki user and root (the
# attach helper) can connect to the block device. The control socket is
# chmod'd 0660 explicitly by the daemon (SPEC 7).
UMask=0077
RuntimeDirectory=maki/%i
# 0750 with the group the daemon sets to `control.group` (maki-admin): an
# administrator must be able to traverse the directory to reach
# control.sock, and cannot open nbd.sock (0700 under the umask above).
RuntimeDirectoryMode=0750
ReadWritePaths=/var/lib/maki/%i
ReadWritePaths=/run/maki/%i

# SPEC §9: secrets arrive as systemd credentials, never in the TOML.
# Uncomment and point at the real secret source for the volume:
LoadCredential=crypto-token:/etc/maki/secrets/%i.token

[Install]
WantedBy=multi-user.target
